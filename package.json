{
  "name": "saml-sp",
  "version": "3.0.0",
  "description": "Secure-by-default SAML 2.0 Service Provider for Node.js — signature verification, IdP metadata parsing, typed errors, zero native dependencies.",
  "keywords": [
    "saml",
    "saml2",
    "saml2.0",
    "sso",
    "single-sign-on",
    "service-provider",
    "authentication",
    "identity",
    "federation",
    "okta",
    "entra",
    "azure-ad",
    "xml-signature",
    "auth"
  ],
  "homepage": "https://github.com/NabilAldhamari/saml-sp#readme",
  "bugs": {
    "url": "https://github.com/NabilAldhamari/saml-sp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NabilAldhamari/saml-sp.git"
  },
  "license": "MIT",
  "author": "Nabil Al-Dhamari",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.0",
    "selfsigned": "^2.4.1",
    "xml-crypto": "^6.1.2",
    "xml-encryption": "^3.0.2",
    "xmlbuilder2": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "@types/xml-encryption": "^1.2.4",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "^3.9.4",
    "ts-jest": "^29.4.11",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
